{
  "name": "gmail-system-theme-mode",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "web-ext lint",
    "start:firefox": "web-ext run --start-url https://mail.google.com",
    "build": "web-ext build --overwrite-dest",
    "sign": "web-ext sign --channel unlisted",
    "sign:listed": "web-ext sign --channel listed --amo-metadata amo/metadata.json",
    "amo:listing": "node scripts/amo-listing.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "puppeteer": "^25.13.0",
    "web-ext": "^10.7.0"
  },
  "webExt": {
    "ignoreFiles": [
      "test",
      "amo",
      "scripts",
      "images/icon.svg",
      "package.json",
      "package-lock.json"
    ]
  }
}
